# ─────────────────────────────────────────────────────────────────────────────
#  Smart Creator — variables d'environnement
#  Copier ce fichier en `.env` et renseigner les valeurs. `.env` est gitignoré.
#  RÈGLE ABSOLUE : aucune de ces clés ne doit être exposée au navigateur.
#  Le frontend n'appelle jamais un fournisseur IA en direct — tout transite
#  par le backend. Aucune variable ici ne doit être préfixée VITE_.
# ─────────────────────────────────────────────────────────────────────────────

# --- Serveur ---
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173

# --- Orchestrateur IA : texte ---
# Gemini (fournisseur actuel du code hérité d'AI Studio)
GEMINI_API_KEY=

# --- Orchestrateur IA : vidéo (module 6.4.2 / 6.4.3 du cahier des charges) ---
# Higgsfield AI — génération texte-à-vidéo + Genjutsu (Motion Transfer/Object Swap)
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_URL=https://api.higgsfield.ai

# --- Gamma — storybooks & documents illustrés (module 6.8) ---
GAMMA_API_KEY=

# --- Ingestion publicitaire (module 6.1 — Radar Marché) ---
# Meta Ad Library API. Nécessite App Review + Business Verification pour
# l'Accès Avancé. Cf. docs/INTEGRATIONS.md, section « démarches ».
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# --- Conformité publicitaire (module 6.4.1) ---
# Table de règles éditable sans redéploiement. Laisser vide pour utiliser
# server/config/compliance-rules.json, résolu depuis le répertoire de travail.
# Le fichier doit rester EXTERNE au bundle : l'inliner supprimerait la
# possibilité de le corriger sans redéployer, exigée par le cahier des charges.
# Si la table est introuvable, le serveur refuse tout export (échec fermé).
COMPLIANCE_RULES_PATH=

# --- Grille tarifaire des research points (module 8) ---
# Mêmes contraintes que la table de conformité : fichier externe, éditable sans
# redéploiement. Laisser vide pour server/config/credit-costs.json.
# ATTENTION : la valeur du point (pointValueFcfa) y est PROVISOIRE et doit être
# validée commercialement avant toute mise en production facturée.
CREDIT_COSTS_PATH=

# --- Base de données & cache ---
DATABASE_URL=postgresql://user:password@localhost:5432/smartcreator
REDIS_URL=redis://localhost:6379

# --- Sécurité ---
# Générer avec : openssl rand -hex 32
SESSION_SECRET=
JWT_SECRET=
# Origines autorisées en CORS, séparées par des virgules
CORS_ORIGINS=http://localhost:5173
