# ─────────────────────────────────────────────────────────────────────────────
#  Smart Creator — variables d'environnement
#  Copier ce fichier en `.env` et renseigner les valeurs. `.env` est gitignoré.
#  RÈGLE ABSOLUE : aucune de ces clés ne doit être exposée au navigateur.
#  Le frontend n'appelle jamais un fournisseur IA en direct — tout transite
#  par le backend. Aucune variable ici ne doit être préfixée VITE_.
# ─────────────────────────────────────────────────────────────────────────────

# --- Serveur ---
NODE_ENV=development
PORT=3001
# Adresse d'écoute de l'API. Vide = 127.0.0.1 en développement (seul ce poste peut
# l'appeler, pas les autres appareils du Wi-Fi) et 0.0.0.0 en production.
HOST=
# Proxys devant le serveur (lecture de la vraie adresse IP des visiteurs). 1 derrière un
# hébergeur ou un répartiteur de charge ; 0 si le serveur est joint directement, sinon
# n'importe qui pourrait se forger une adresse. Vide = 1 en production.
TRUST_PROXY=
APP_URL=http://localhost:5173

# --- Orchestrateur IA : texte ---
# Gemini : rédaction des analyses de niche, des produits et du kit, traduction des guides, Vidéo → Produit.
# Clé créée dans Google AI Studio ; envoyée en en-tête par le serveur, jamais au navigateur.
GEMINI_API_KEY=
# Facultatif : modèle (défaut gemini-3.5-flash) et adresse de l'API.
GEMINI_MODEL=
GEMINI_API_URL=
# Facultatif : modèle de secours quand le modèle principal est saturé chez Google (réponse 503),
# après une seconde tentative. Défaut gemini-3.6-flash ; « off » pour ne jamais changer de modèle.
GEMINI_FALLBACK_MODEL=

# --- Paiement en ligne des paliers (Stripe Checkout, carte bancaire) ---
# Clé secrète : sk_test_… en mode test (aucune carte réelle débitée), sk_live_… en réel.
# Webhook : Stripe → Développeurs → Webhooks → adresse https://votre-domaine/api/billing/webhook,
# événements checkout.session.completed, checkout.session.async_payment_succeeded et
# checkout.session.expired ; recopier le secret de signature (whsec_…).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_URL=

# --- E-mails transactionnels : mot de passe oublié, confirmation d'adresse, alertes ---
# Brevo (brevo.com) ou Resend (resend.com). Sans configuration, le mot de passe oublié
# passe par l'administrateur et la confirmation d'adresse n'est pas proposée.
# EMAIL_FROM : adresse d'un domaine vérifié chez le fournisseur,
# ex. Smart Creator <no-reply@votre-domaine.com>
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_API_URL=
# Boîte de l'équipe : copie de chaque message de la page Contact et avis de chaque paiement en ligne.
CONTACT_INBOX_EMAIL=

# Recherche web des analyses de niche (API Search de Perplexity, perplexity.ai/account/api).
# Pages brutes rédigées ensuite par Gemini. Sans clé, l'analyse fonctionne mais n'avance
# aucun fait de marché (concurrents, prix, demande) et le dit. La recherche Google intégrée
# à Gemini n'est pas utilisée : ses conditions interdisent de conserver ou d'exporter les
# résultats, alors que les rapports sont conservés et exportés.
PERPLEXITY_API_KEY=
PERPLEXITY_API_URL=

# --- Orchestrateur IA : visuels et vidéo (modules 6.4.2 / 6.4.3 du cahier des charges) ---
# Higgsfield — identifiants créés dans Higgsfield Cloud (cloud.higgsfield.ai) : un
# identifiant et un secret, envoyés en « Authorization: Key ID:SECRET ».
# Utilisez des identifiants distincts en développement et en production.
# ATTENTION : l'API publique n'expose ni avatars parlants, ni Motion Transfer, ni
# Object Swap (spécification OpenAPI consultée le 14/09/2026). Ces fonctions du
# cahier des charges ne peuvent pas être branchées en l'état.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_API_URL=https://api.higgsfield.ai

# --- Gamma — storybooks & documents illustrés (module 6.8) ---
GAMMA_API_KEY=
# API publique Gamma v1.0 (en-tête X-API-KEY), réservée aux offres Pro, Ultra,
# Teams et Business. Chaque conte consomme des crédits du compte Gamma du
# serveur, en plus des points Smart Creator de l'auteur : un compte à court de
# crédits rend le module indisponible pour tous les utilisateurs.
# Les contes sont partagés en lecture seule avec quiconque détient leur lien.

# --- Conformité publicitaire (module 6.4.1) ---
# Table de règles éditable sans redéploiement. Laisser vide pour utiliser
# server/config/compliance-rules.json, résolu depuis le répertoire de travail.
# Le fichier doit rester EXTERNE au bundle : l'inliner supprimerait la
# possibilité de le corriger sans redéployer, exigée par le cahier des charges.
# Si la table est introuvable, le serveur refuse tout export (échec fermé).
COMPLIANCE_RULES_PATH=

# --- Grille tarifaire des research points (module 8) ---
# Mêmes contraintes que la table de conformité : fichier externe, éditable sans
# redéploiement. Laisser vide pour server/config/credit-costs.json.
# ATTENTION : la valeur du point (pointValueFcfa) y est PROVISOIRE et doit être
# validée commercialement avant toute mise en production facturée.
CREDIT_COSTS_PATH=

# --- Fourchettes de prix produits & CPA publicitaire (CdC §2) ---
# Le cahier des charges exige des fourchettes « dynamiques en base, jamais
# figées dans le code ». Laisser vide pour server/config/pricing.json.
# Les bornes actuelles sont PROVISOIRES : reprises telles quelles depuis
# l'ancien code figé, sans source marché. À réviser sur données réelles.
PRICING_PATH=

# --- Vérificateur d'originalité (feuille de route 3.2) ---
# Seuil bloquant, taille des n-grammes et corpus de référence, éditables sans
# redéploiement. Laisser vide pour server/config/originality.json.
# La mesure porte sur un corpus CONNU, pas sur le web : ne pas la présenter
# comme une détection de plagiat universelle.
ORIGINALITY_PATH=

# --- Structures de campagnes Meta et TikTok (feuille de route 5.4) ---
# Objectifs officiels, répartitions de budget et règles de pilotage. Laisser vide
# pour server/config/campaign-blueprints.json. Répartitions et règles PROVISOIRES.
CAMPAIGN_BLUEPRINTS_PATH=

# --- Kit de lancement (feuille de route 5.1) ---
# Boutons officiels d'appel à l'action et découpages des scripts 15/30/60 s.
# Laisser vide pour server/config/launch-kit.json. Découpages PROVISOIRES.
LAUNCH_KIT_PATH=

# --- Distribution : connecteur Chariow (feuille de route 5.2) ---
# Clé créée dans app.chariow.com → Paramètres → Clés API (en-tête Bearer).
# Clé de la boutique du PROPRIÉTAIRE : elle ne sert qu'aux comptes administrateurs.
# Chaque autre utilisateur enregistre sa propre clé dans Mon compte → Connexions
# (vérifiée auprès de Chariow, chiffrée en base, jamais renvoyée au navigateur).
# Serveur uniquement : ne jamais l'exposer au navigateur.
# L'API Chariow permet de LIRE produits et ventes, pas de publier un produit.
# Maketou et Taliopay n'ont pas d'API publique documentée : pas de clé à prévoir.
CHARIOW_API_KEY=
# URL de l'API, surchargeable pour les tests contre un serveur factice.
CHARIOW_API_URL=https://api.chariow.com/v1

# --- Base de données (comptes, sessions, crédits, paiements) ---
# PostgreSQL. En production : Supabase (Project Settings → Database → Connection
# string, mode « Transaction pooler »), obligatoire. Vide en développement : base
# PostgreSQL embarquée dans .data/pglite, exclue de Git.
# Les migrations du dossier server/db/migrations/ s'appliquent au démarrage du serveur.
DATABASE_URL=

# --- Sécurité ---
# Premier administrateur d'une nouvelle installation (hébergeur sans terminal, comme Render gratuit) :
# créé au démarrage tant qu'aucun administrateur n'existe ; le journal du serveur affiche un lien à
# usage unique (24 h) pour choisir le mot de passe. Sans effet ensuite : peut être retirée.
ADMIN_BOOTSTRAP_EMAIL=
# Clé de chiffrement des secrets stockés en base (double authentification, clés
# API Chariow des utilisateurs). 64 caractères hexadécimaux, obligatoire en
# production. Générer avec : openssl rand -hex 32
# La perdre rend ces secrets illisibles : la sauvegarder hors de Git.
DATA_ENCRYPTION_KEY=
# Fuseau des statistiques « aujourd'hui / ce mois / cette année » de l'administration
REPORTING_TIMEZONE=Africa/Abidjan
# Paliers d'abonnement (quotas, prix, fonctions). Vide : server/config/plans.json
PLANS_PATH=
# Taux de change pour afficher les prix dans la devise de chaque pays (données ouvertes, sans clé).
# Vide : ExchangeRate-API. « off » : taux de repli de server/config/exchange-rates.json uniquement.
EXCHANGE_RATES_URL=
# Origines autorisées en CORS, séparées par des virgules
CORS_ORIGINS=http://localhost:5173
