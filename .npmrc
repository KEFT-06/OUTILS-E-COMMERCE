# Réglages pour connexion instable.
# Le registre npm coupait la connexion (ECONNRESET) avec les réglages par
# défaut : trop de connexions parallèles et des délais d'attente trop courts.
maxsockets=3
fetch-retries=10
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=900000
prefer-offline=true
fund=false
audit=false
