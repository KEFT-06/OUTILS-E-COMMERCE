+function extractJson(text: string): string {
+  const firstBrace = text.indexOf('{');
+  const firstBracket = text.indexOf('[');
+  let startIndex = -1;
+  let isObject = false;
+  if (firstBrace !== -1 && firstBracket !== -1) {
+    if (firstBrace < firstBracket) { startIndex = firstBrace; isObject = true; }
+    else { startIndex = firstBracket; isObject = false; }
+  } else if (firstBrace !== -1) { startIndex = firstBrace; isObject = true; }
+  else if (firstBracket !== -1) { startIndex = firstBracket; isObject = false; }
+  
+  if (startIndex === -1) return text;
+  
+  const lastIndex = isObject ? text.lastIndexOf('}') : text.lastIndexOf(']');
+  
+  if (lastIndex === -1 || lastIndex < startIndex) return text;
+  
+  return text.substring(startIndex, lastIndex + 1);
+}
